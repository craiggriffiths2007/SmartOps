@{
    ViewData["Title"] = "Mart Ops Demo";
}

<div class="container py-4">

    <h1>Mart Ops Demonstration System</h1>

    <p class="lead">
        This website is a demonstration version of Mart Ops,
        provided for portfolio, technical evaluation and general
        interest purposes.
    </p>

    <p>
        The system demonstrates the design and development of a
        real-world business application for the glazing repair industry,
        covering workflows including customer and contract management,
        surveying, fitting, job scheduling and field operations.
    </p>

    <h3>Technology</h3>

    <p>
        Mart Ops has been designed and developed using technologies
        including C#, .NET, ASP.NET Core MVC, Entity Framework Core,
        SQL Server, REST APIs and .NET MAUI.
    </p>

    <h3>Test Data</h3>

        <p>
        Customers and Contracts can be included with your free company account for demo purposes.
    </p>

    <p>
        All customers, contracts, jobs and other information within this
        demonstration environment are fictional and provided for testing
        purposes only. Any data created or entered while using the system
        is considered test data and may be periodically deleted.
    </p>

    <p>
        Please do not enter any real personal, customer or commercially
        sensitive information into the demonstration system.
    </p>

    <div class="text-center">
    <a asp-area="Identity"
       asp-page="/Account/Register"
       class="btn btn-primary mt-2">
        Register for a Free Demo
    </a>
</div>
</div>