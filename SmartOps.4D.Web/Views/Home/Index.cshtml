<div id="screenshotLightbox" class="screenshot-lightbox">
    <button type="button"
            class="screenshot-lightbox-close"
            id="screenshotLightboxClose">
        &times;
    </button>

    <button type="button"
            class="screenshot-lightbox-prev"
            id="screenshotLightboxPrev">
        &#10094;
    </button>

    <img id="screenshotLightboxImage"
         class="screenshot-lightbox-image"
         alt="Mart Ops screenshot" />

    <button type="button"
            class="screenshot-lightbox-next"
            id="screenshotLightboxNext">
        &#10095;
    </button>

    <div id="screenshotLightboxCounter"
         class="screenshot-lightbox-counter">
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const galleries = {
            backoffice: [
                "/img/screenshot1.png",
                "/img/screenshot2.png",
                "/img/screenshot3.png",
                "/img/screenshot4.png",
                "/img/screenshot5.png",
                "/img/screenshot6.png",
                "/img/screenshot7.png",
                "/img/screenshot8.png",
                "/img/screenshot9.png",
                "/img/screenshot10.png",
                "/img/screenshot11.png"
            ],

            customer: [
                "/img/CustShots/Shot1.jpg",
                "/img/CustShots/Shot2.jpg",
                "/img/CustShots/Shot3.jpg",
                "/img/CustShots/Shot4.jpg"
            ],

            field: [
                "/img/FieldShots/Shot1.jpg",
                "/img/FieldShots/Shot2.jpg",
                "/img/FieldShots/Shot3.jpg",
                "/img/FieldShots/Shot4.jpg",
                "/img/FieldShots/Shot5.jpg",
                "/img/FieldShots/Shot6.jpg",
                "/img/FieldShots/Shot7.jpg",
                "/img/FieldShots/Shot8.jpg"
            ]
        };

        let activeGallery = galleries.backoffice;
        let currentScreenshot = 0;

        const lightbox =
            document.getElementById("screenshotLightbox");

        const image =
            document.getElementById("screenshotLightboxImage");

        const counter =
            document.getElementById("screenshotLightboxCounter");

        function showScreenshot(index) {

            if (index < 0)
                index = activeGallery.length - 1;

            if (index >= activeGallery.length)
                index = 0;

            currentScreenshot = index;

            image.src = activeGallery[currentScreenshot];

            counter.textContent =
                (currentScreenshot + 1) +
                " / " +
                activeGallery.length;
        }

        function openLightbox(galleryName, index) {

            activeGallery =
                galleries[galleryName] || galleries.backoffice;

            showScreenshot(index || 0);

            lightbox.classList.add("show");
            document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
            lightbox.classList.remove("show");
            document.body.style.overflow = "";
        }

        document
            .querySelectorAll(".phone-lightbox-trigger, #backofficeGalleryOpen")
            .forEach(function (trigger) {

                trigger.addEventListener("click", function (event) {

                    event.preventDefault();

                    openLightbox(
                        trigger.dataset.gallery,
                        parseInt(trigger.dataset.index || "0", 10)
                    );
                });
            });

        document
            .getElementById("screenshotLightboxClose")
            .addEventListener("click", closeLightbox);

        document
            .getElementById("screenshotLightboxPrev")
            .addEventListener("click", function () {
                showScreenshot(currentScreenshot - 1);
            });

        document
            .getElementById("screenshotLightboxNext")
            .addEventListener("click", function () {
                showScreenshot(currentScreenshot + 1);
            });

        lightbox.addEventListener("click", function (event) {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", function (event) {

            if (!lightbox.classList.contains("show"))
                return;

            if (event.key === "Escape")
                closeLightbox();

            if (event.key === "ArrowLeft")
                showScreenshot(currentScreenshot - 1);

            if (event.key === "ArrowRight")
                showScreenshot(currentScreenshot + 1);
        });
    });
</script>
