@inject SmartOps.Web.Services.BuildInfoService BuildInfo
@{
    ViewData["Title"] =
        "Mart Ops | Complete Field Service Management";

    ViewData["Description"] =
        "Mart Ops is a cloud-based field service management platform. "
        + "Manage jobs, appointments, field operatives and customers "
        + "with customisable questions, mobile working and offline support.";
}
<link rel="canonical" href="https://glassops.co.uk/" />

<link rel="stylesheet" href="~/css/pages/home-gallery.css" asp-append-version="true" />


<div class="home-page">

    <header class="go-hero">
        <div class="go-wrap hero-grid">

            <div class="hero-brand">
                <img src="~/img/splash.png"
                     class="hero-splash"
                     alt="Smart Ops" />

                <div>
                    <h1 class="logo-title">
                        <span class="glass">Smart</span>
                        <span class="ops">Ops</span>
                    </h1>

                    <div class="hero-copy">
                        <strong>Field Service Management</strong>
                      
                    </div>
                </div>
            </div>

         

        </div>
    </header>


     <section>
        <div class="go-wrap feature-grid">
           
<div class="copy">

    <h2>Job Magement</h2>

    <p>
        Take control of your entire field service operation with
        one centralised, cloud-based platform. Manage customers,
        jobs, appointments, reports and communications, keeping
        your office and field teams connected at every stage.
    </p>

    <ul class="checks">
        <li>Manage customers, contracts and job information</li>
        <li>Schedule appointments and allocate work to field operatives</li>
        <li>Track every job from initial enquiry through to completion</li>
        <li>Access detailed reports, measurements and specifications</li>
        <li>View photographs, videos, drawings and digital signatures</li>
        <li>Manage vehicle inspections, tool checks and safety records</li>
        <li>Record spot checks, quality inspections and accidents</li>
        <li>Keep everyone informed with job updates and communications</li>
    </ul>

                <!--<div class="free-demo-wrap">
        <a asp-area="Identity"
           asp-page="/Account/Register"
           class="free-demo-button">
            CREATE A FREE ACCOUNT
        </a>
    </div>-->

</div>


            <div class="backoffice-screenshot">
                <img src="~/img/diaryscreenshot.png"
                     alt="Mart Ops back-office diary and repair management system"
                     class="backoffice-gallery-image lightbox-trigger"
                     id="backofficeGalleryOpen"
                     data-gallery="backoffice"
                     data-index="0"
                     title="Click to view Mart Ops back-office screenshots" />
            </div>
        </div>
    </section>








</div>


<div id="screenshotLightbox" class="screenshot-lightbox">
    <button type="button"
            class="screenshot-lightbox-close"
            id="screenshotLightboxClose">
        &times;
    </button>

    <button type="button"
            class="screenshot-lightbox-prev"
            id="screenshotLightboxPrev">
        &#10094;
    </button>

    <img id="screenshotLightboxImage"
         class="screenshot-lightbox-image"
         alt="Mart Ops screenshot" />

    <button type="button"
            class="screenshot-lightbox-next"
            id="screenshotLightboxNext">
        &#10095;
    </button>

    <div id="screenshotLightboxCounter"
         class="screenshot-lightbox-counter">
    </div>
</div>
