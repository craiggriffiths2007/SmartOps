@model IEnumerable<SmartOps.Web.Models.Tenant>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Companies</h4>

</div>

<hr />
@{
    var pendingApprovals =
        ViewBag.PendingApprovals as Dictionary<int?, string>
        ?? new Dictionary<int?, string>();
}
@if (!Model.Any())
{
    <p class="text-muted py-3">No records found.</p>
}
<div class="record-cards">
@foreach (var item in Model) {
        <article class="record-card">
    <div class="record-card-title fw-bold"><a href="@Url.Action("Details", new { id = item.Id })" class="stretched-link">@Html.DisplayFor(model => item.Name)</a></div>
    <div class="record-card-fields">
                <div class="record-card-field">
                <span class="record-field-label">@Html.DisplayNameFor(model => model.Id)</span>
                @Html.DisplayFor(model => item.Id)
            </div>

            <div class="record-card-field">
                <span class="record-field-label">@Html.DisplayNameFor(model => model.Code)</span>
                @Html.DisplayFor(model => item.Code)
            </div>
            <div class="record-card-field">
                <span class="record-field-label">@Html.DisplayNameFor(model => model.IsActive)</span>
                @Html.DisplayFor(model => item.IsActive)
            </div>
            <div class="record-card-field">
                <span class="record-field-label">@Html.DisplayNameFor(model => model.Created)</span>
                @Html.DisplayFor(model => item.Created)
            </div>
            <div class="record-card-field"><span class="record-field-label">Actions</span>
@if (pendingApprovals.TryGetValue(item.Id, out var pendingUserId))
                {
                    <a asp-area="" asp-controller="RegistrationApproval"
                       asp-action="Review" asp-route-userId="@pendingUserId"
                       class="badge bg-warning text-dark text-decoration-none"
                       title="Review pending registration">
                        Awaiting approval
                    </a>
                }
</div>

    </div>
</article>
}
</div>
<record-pagination></record-pagination>
