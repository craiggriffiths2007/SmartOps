@model IEnumerable<SmartOps.Web.Models.Branch>
@{
    ViewData["Title"] = "Branches";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Branches</h4>
    <a asp-action="Create" class="btn btn-primary">Add Branch</a>
</div>
<div class="table-responsive record-index-list">
    <table class="table table-sm table-hover align-middle record-index-table mb-0">
        <caption class="visually-hidden">Branches</caption>
        <thead>
            <tr>
                <th scope="col">Code</th>
                <th scope="col">Location</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="3" class="text-muted py-3">No records found.</td></tr>
            }
            @foreach (var item in Model)
            {
                var detailsUrl = Url.Action("Details", new { id = item.Id });
                <tr class="clickable-row" data-href="@detailsUrl" tabindex="0">
                    <th scope="row">@(string.IsNullOrWhiteSpace(item.Code) ? $"Branch {item.Id}" : item.Code)</th>
                    <td>@item.Name</td>
                    <td class="record-index-text">@item.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<record-pagination></record-pagination>