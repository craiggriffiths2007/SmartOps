@model SmartOps.Web.ViewModels.ContractDetailsViewModel

@{
    ViewData["Title"] = "Details";

    var selectedEstimate = Model.Estimates.FirstOrDefault(e => e.Id == Model.Contract.SelectedEstimateId);

    var activeTab =
        Context.Request.Query["tab"].ToString();

    if (string.IsNullOrWhiteSpace(activeTab))
        activeTab = "updates";

    if (activeTab == "contact")
        activeTab = "customer";

    var thisContractUrl = Url.Action(
        "Details",
        "Contracts",
        new { id = Model.Contract.Id, tab = "customer", returnUrl = ViewBag.ReturnUrl });

    var bookingsReturnUrl = Url.Action(
        "Details",
        "Contracts",
        new { id = Model.Contract.Id, tab = "bookings", returnUrl = ViewBag.ReturnUrl });
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Contract</h4>

    @if (ViewBag.ReturnUrl != null)
    {
        <a href="@ViewBag.ReturnUrl" class="btn btn-secondary">Back</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    }
</div>

<hr />

<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.ContractCode)
            </div>
            <div>
                @Html.DisplayFor(model => model.Contract.ContractCode)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.IncidentDate)
            </div>
            <div>
                @Html.DisplayFor(model => model.Contract.IncidentDate)
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.InsurerId)
            </div>
            <div>
                @(Model.Contract.Insurer?.Name ?? "None (Domestic)")
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.CauseOfDamage)
            </div>
            <div>
                @Html.DisplayFor(model => model.Contract.CauseOfDamage)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.DamageDescription)
            </div>
            <div>
                @Html.DisplayFor(model => model.Contract.DamageDescription)
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Contract.Status)
            </div>

            <div class="@(Model.Contract.IsCancelled ? "text-danger fw-bold" : "")">
                @if (Model.Contract.IsCancelled)
                {
                    <span>Cancelled</span>
                }
                else
                {
                    <div class="contract-status-progress mb-2">
                        @await Html.PartialAsync("_ContractProgress", new SmartOps.Web.ViewModels.ContractIndexViewModel
                        {
                            Contract = Model.Contract,
                            Headers = Model.JobsReceived
                        })
                    </div>
                    <div id="contract-status-display">
                        <div>@SmartOps.Web.Helpers.ItemDisplayNameHelper.GetDisplayName(Model.Contract.Status.ToString())</div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2"
                                data-change-contract-status aria-controls="contract-status-form" aria-expanded="false">Change status</button>
                    </div>
                    <form id="contract-status-form" asp-action="UpdateStatus" method="post" hidden
                          onsubmit="return confirm('Are you sure you want to change this contract status?');">
                        <input type="hidden" name="id" value="@Model.Contract.Id" />
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <label for="contract-status" class="visually-hidden">Contract status</label>
                        <select id="contract-status" name="status" class="form-select mb-2">
                            @foreach (var status in Enum.GetValues<ContractStatus>())
                            {
                                <option value="@status" selected="@(Model.Contract.Status == status)">@SmartOps.Web.Helpers.ItemDisplayNameHelper.GetDisplayName(status.ToString())</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Save status</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel-contract-status>Cancel</button>
                    </form>
                }
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold mb-2">Traffic Light</div>
            @await Html.PartialAsync("_AutomaticTrafficLight", Model.Contract)
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                Next Appointment
            </div>

            <div>
                @if (Model.NextJob != null)
                {
                    <a asp-controller="Jobs"
                       asp-action="Details"
                       asp-route-id="@Model.NextJob.Id"
                       class="text-decoration-none">

                        @Model.NextJob.DiaryDate.ToString("dd/MM/yyyy")
                        @Model.NextJob.Time.ToString(@"hh\:mm")
                        @Model.NextJob.JobType.ToString()[0]

                    </a>
                }
                else
                {
                    <span class="text-muted">
                        No appointment
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedEstimate != null && !selectedEstimate.IsAuthorized && !Model.Contract.IsCancelled)
{
    <form asp-controller="Estimates" asp-action="Authorize" method="post" class="my-3"
          onsubmit="return confirm('Authorize the chosen estimate and update the contract status?');">
        <input type="hidden" name="contractId" value="@Model.Contract.Id" />
        <input type="hidden" name="estimateId" value="@selectedEstimate.Id" />
        <button type="submit" class="btn btn-success">Authorize estimate: @selectedEstimate.ServiceLevel</button>
    </form>
}

@if (Model.InvoiceId.HasValue)
{
    <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-primary my-3">View Invoice</a>
}
else if (Model.Contract.Status == ContractStatus.FittingCompleted && !Model.Contract.IsCancelled)
{
    <a asp-controller="Invoices" asp-action="Create" asp-route-contractId="@Model.Contract.Id" class="btn btn-primary my-3">Invoice</a>
}



<div class="d-flex justify-content-between align-items-center">

    <div>
        @if (Model.Contract.IsActive &&
             Model.Contract.IsCancelled != true)
        {
            <a asp-action="Cancel"
               asp-route-id="@Model.Contract.Id"
               class="btn btn-danger">
                Cancel Contract
            </a>
        }
    </div>

    <div>
        <a asp-controller="Jobs"
           asp-action="Create"
           asp-route-contractId="@Model.Contract.Id"
           asp-route-returnUrl="@Url.Action("Details", "Contracts", new { id = Model.Contract.Id, tab = "bookings" })"
           class="btn btn-primary">
            <i class="fa fa-calendar-plus me-1"></i>
            Add Booking
        </a>
    </div>

</div>
<br />

<ul class="nav nav-tabs mb-3" id="contractTabs" role="tablist">

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "updates" ? "active" : "")"
                id="updates-tab"
                data-bs-toggle="tab"
                data-bs-target="#updates"
                type="button">
            Contract Updates
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "bookings" ? "active" : "")"
                id="bookings-tab"
                data-bs-toggle="tab"
                data-bs-target="#bookings"
                type="button">
            Bookings
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "received" ? "active" : "")"
                id="received-tab"
                data-bs-toggle="tab"
                data-bs-target="#received"
                type="button" role="tab" aria-controls="received" aria-selected="@(activeTab == "received" ? "true" : "false")">
            Jobs received
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "estimation" ? "active" : "")" id="estimation-tab"
                data-bs-toggle="tab" data-bs-target="#estimation" type="button" role="tab" aria-controls="estimation"
                aria-selected="@(activeTab == "estimation" ? "true" : "false")">Estimation</button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "notes" ? "active" : "")"
                id="notes-tab"
                data-bs-toggle="tab"
                data-bs-target="#notes"
                type="button">
            Contract Notes
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "insurer" ? "active" : "")"
                id="insurer-tab"
                data-bs-toggle="tab"
                data-bs-target="#insurer"
                type="button">
            Insurer Contact
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "customer" ? "active" : "")"
                id="customer-tab"
                data-bs-toggle="tab"
                data-bs-target="#customer"
                type="button" role="tab" aria-controls="customer"
                aria-selected="@(activeTab == "customer" ? "true" : "false")">
            Customer Details
        </button>
    </li>

</ul>

<div class="tab-content" id="contractTabsContent">

    <div class="tab-pane @(activeTab == "customer" ? "show active" : "")"
         id="customer" role="tabpanel" aria-labelledby="customer-tab">
        <div class="row">
            <div class="col-md-6">
                <h5 class="mb-3">Customer</h5>

                <div class="mb-3">

                    <div>
                        @if (Model.Contract.Customer != null)
                        {
                            <a asp-controller="Customers"
                               asp-action="Details"
                               asp-route-id="@Model.Contract.Customer.Id"
                               asp-route-contractId="@Model.Contract.Id"
                               asp-route-returnUrl="@thisContractUrl"
                               class="text-decoration-none">
                                @Model.Contract.Customer.Name
                            </a>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <div class="fw-bold">
                        Address
                    </div>

                    <div>
                        @Model.Contract.Customer?.Add1
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Contract.Customer?.Add2))
                    {
                        <div>
                            @Model.Contract.Customer.Add2
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Contract.Customer?.Add3))
                    {
                        <div>
                            @Model.Contract.Customer.Add3
                        </div>
                    }

                    <div>
                        @Model.Contract.Customer?.Postcode
                    </div>
                </div>

                <div class="mb-3">
                    <div class="fw-bold">
                        Phone
                    </div>
                    <div>
                        @Model.Contract.Customer?.Phone1
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Contract.Customer?.Phone2))
                {
                    <div class="mb-3">
                        <div class="fw-bold">
                            Phone 2
                        </div>
                        <div>
                            @Model.Contract.Customer.Phone2
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Contract.Customer?.Phone3))
                {
                    <div class="mb-3">
                        <div class="fw-bold">
                            Phone 3
                        </div>
                        <div>
                            @Model.Contract.Customer.Phone3
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <div class="fw-bold">
                        Email
                    </div>
                    <div>
                        @Model.Contract.Customer?.Email
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <h5 class="mb-3">App Login Details</h5>
                <partial name="_CustomerAppLogin" model="Model.Contract" />
            </div>
        </div>

        <!-- CUSTOMER CONTACT -->
        <section id="contact" class="border-top mt-4 pt-3" aria-labelledby="customer-contact-heading">

            <h4 id="customer-contact-heading">Customer Contact</h4>

            <p class="text-muted">
                Messages sent by the customer regarding this contract.
            </p>

            @if (Model.SupportTickets == null ||
                 !Model.SupportTickets.Any())
            {
                <div class="alert alert-light border">
                    There are no customer messages for this contract.
                </div>
            }
            else
            {
                <div class="record-cards" data-paginate>
    @foreach (var ticket in Model.SupportTickets)
                {
                    <div class="record-card">

                        <div class="card-header d-flex justify-content-between align-items-center">

                            <strong>
                                @ticket.Subject
                            </strong>

                            <span class="badge bg-secondary">
                                @ticket.Status
                            </span>

                        </div>

                        <div class="card-body">

                            <div class="record-cards" data-paginate>
    @foreach (var message in ticket.Messages
                                .OrderBy(x => x.Created))
                            {
                                <div class="record-card">

                                    <div class="small text-muted">

                                        @if (message.Sender == TicketMessageSender.Customer)
                                        {
                                            <strong>Customer</strong>
                                        }
                                        else
                                        {
                                            <strong>
                                                @(message.SentByUser != null
                                                    ? $"{message.SentByUser.FirstName} {message.SentByUser.LastName}".Trim()
                                                    : "Head Office")
                                            </strong>
                                        }

                                        -
                                        @message.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")

                                    </div>

                                    <div>
                                        @message.Message
                                    </div>

                                </div>
                            }
    </div>

                            <form asp-action="ReplyToTicket"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="TicketId"
                                       value="@ticket.Id" />

                                <input type="hidden"
                                       name="ContractId"
                                       value="@Model.Contract.Id" />

                                <div class="form-group">

                                    <label class="control-label">
                                        Reply
                                    </label>

                                    <textarea name="Message"
                                              class="form-control"
                                              rows="3"></textarea>

                                </div>

                                <div class="mt-2">

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Reply
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>
                }
    </div>
            }

        </section>
    </div>

    <!-- CONTRACT UPDATES -->
    <div class="tab-pane @(activeTab == "updates" ? "show active" : "")"
         id="updates">

        <h4>Contract Updates</h4>

        @if (Model.ContractUpdates == null || !Model.ContractUpdates.Any())
        {
            <div class="alert alert-light border">
                There are no updates for this contract.
            </div>
        }
        else
        {
            <div class="record-cards" data-paginate>
@foreach (var update in Model.ContractUpdates)
            {
                <div class="record-card">

                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@update.Title</strong>

                        <span class="badge bg-secondary">
                            @update.Status
                        </span>
                    </div>

                    <div class="card-body">

                        <div class="small text-muted mb-2">
                            @update.DateTime.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(update.Description))
                        {
                            <div>
                                @update.Description
                            </div>
                        }

                        @if (update.CustomerVisible)
                        {
                            <div class="mt-2">
                                <span class="badge bg-success">
                                    Visible to customer
                                </span>
                            </div>
                        }

                    </div>

                </div>
            }
</div>
        }

    </div>

    <!-- BOOKINGS -->
    <div class="tab-pane @(activeTab == "bookings" ? "show active" : "")"
         id="bookings">

        <h4>Bookings</h4>

        @if (Model.Bookings == null || !Model.Bookings.Any())
        {
            <div class="alert alert-light border">
                There are no bookings for this contract.
            </div>
        }
        else
        {
            <div class="record-cards day-bookings mb-3" data-paginate>
                @foreach (var booking in Model.Bookings.OrderByDescending(b => b.DiaryDate).ThenByDescending(b => b.Time))
                {
                    var endTime = booking.Time.Add(booking.JobTime);
                    var jobClass = booking.JobType.ToString() == "Survey" ? "job-type-survey"
                        : booking.JobType.ToString() == "Fitting" ? "job-type-fitting" : "job-type-remedial";
                    <a class="record-card day-booking-card contract-booking-card text-decoration-none"
                       asp-controller="Jobs"
                       asp-action="Details"
                       asp-route-id="@booking.Id"
                       asp-route-returnUrl="@bookingsReturnUrl">
                        <div class="booking-card-content">
                            <div class="booking-instructions-preview">
                                <div class="ql-editor">
                                    @Html.Raw(booking.Instructions)
                                </div>
                            </div>

                            <div class="booking-card-details">
                                <div class="booking-detail-row booking-card-date">
                                    <span>@booking.DiaryDate.ToString("ddd dd MMM yyyy") · @booking.Time.ToString("HH:mm")-@endTime.ToString("HH:mm")</span>
                                    <span class="day-booking-type-badge @jobClass">@booking.JobType</span>
                                </div>
                                <div class="booking-detail-row">
                                    Allocated: @booking.JobTime.ToString(@"hh\:mm")
                                </div>
                                <div class="booking-detail-row booking-card-operative">
                                    <strong>@(booking.Agent?.Code ?? "Unassigned")</strong>
                                    @if (!string.IsNullOrWhiteSpace(booking.Agent?.Name))
                                    {
                                        <span> - @booking.Agent.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

    </div>

    <!-- JOBS RECEIVED -->
    <div class="tab-pane @(activeTab == "received" ? "show active" : "")"
         id="received" role="tabpanel" aria-labelledby="received-tab">
        <h4>Jobs received</h4>
        @if (!Model.JobsReceived.Any())
        {
            <div class="alert alert-light border">There are no jobs received for this contract.</div>
        }
        else
        {
            <div class="record-cards" data-paginate>
                @foreach (var job in Model.JobsReceived.OrderByDescending(j => j.DateTimeCompleted).ThenByDescending(j => j.Id))
                {
                    <article class="record-card">
                        <h5 class="record-card-title">
                            <a asp-controller="JobHeaders" asp-action="Details" asp-route-id="@job.Id" class="stretched-link">@job.ContractCode · @job.JobType</a>
                        </h5>
                        <div class="record-card-fields">
                            <div class="record-card-field"><span class="record-field-label">Agent</span>@job.AgentCode</div>
                            <div class="record-card-field"><span class="record-field-label">Diary date</span>@job.DiaryDate.ToString("dd/MM/yyyy")</div>
                            <div class="record-card-field"><span class="record-field-label">Completed</span>@job.DateTimeCompleted.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="record-card-field"><span class="record-field-label">Damage</span>@job.DamageDescription</div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="tab-pane @(activeTab == "estimation" ? "show active" : "")" id="estimation" role="tabpanel" aria-labelledby="estimation-tab">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Estimation</h4>
            @if (!Model.Contract.IsCancelled)
            {
                <a asp-controller="Estimates" asp-action="Create" asp-route-contractId="@Model.Contract.Id" class="btn btn-primary">Add estimate</a>
            }
        </div>
        @await Html.PartialAsync("~/Views/Shared/_EstimateList.cshtml", new SmartOps.Web.ViewModels.EstimateListViewModel
        {
            ContractId = Model.Contract.Id, SelectedEstimateId = Model.Contract.SelectedEstimateId,
            IsCancelled = Model.Contract.IsCancelled, Estimates = Model.Estimates
        })
    </div>

    <!-- CONTRACT NOTES -->
    <div class="tab-pane @(activeTab == "notes" ? "show active" : "")"
         id="notes">

        <h4>Contract Notes</h4>

        <div class="table-responsive">
            <table class="table align-top contract-notes-list">
                <thead>
                    <tr>
                        <th scope="col" class="w-25">Date, time and added by</th>
                        <th scope="col">Note</th>
                    </tr>
                </thead>
                <tbody data-paginate data-page-label="Contract note pages">
                    @foreach (var item in Model.ContractNotes)
                    {
                        <tr data-record-row>
                            <td>
                                <time datetime="@item.DateAdded.ToString("s")" class="fw-semibold">@item.DateAdded.ToString("dd/MM/yyyy HH:mm")</time>
                                <div class="text-break">@item.AddedBy</div>
                            </td>
                            <td><div data-contract-note class="text-break border-0">@item.Note</div></td>
                        </tr>
                    }
                    @if (!Model.ContractNotes.Any())
                    {
                        <tr><td colspan="2" class="text-muted">No contract notes yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">

            <div class="col-12">

                <form asp-action="AddNote" method="post" data-contract-note-form>
                    <input type="hidden" name="id" value="@Model.Contract.Id" />

                    <div class="form-group">

                        <label asp-for="Note"
                               class="control-label">
                        </label>

                        <div data-note-editor></div>
                        <textarea asp-for="Note" class="form-control"></textarea>
                        <div data-note-error class="text-danger" role="alert"></div>

                        <span asp-validation-for="Note"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group mt-2">

                        <input type="submit"
                               value="Add Note"
                               class="btn btn-primary" />

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- INSURER CONTACT -->
    <div class="tab-pane @(activeTab == "insurer" ? "show active" : "")"
         id="insurer">

        <h4>Insurer Contact</h4>

        <p class="text-muted">
            Messages between your company and
            @(Model.Contract.Insurer?.Name ?? "the insurer").
        </p>

        @if (Model.InsurerMessages == null ||
             !Model.InsurerMessages.Any())
        {
            <div class="alert alert-light border">
                There are no insurer messages for this contract.
            </div>
        }
        else
        {
            <div class="record-cards" data-paginate>
@foreach (var message in Model.InsurerMessages
                .OrderBy(x => x.Created))
            {
                <div class="record-card">

                    <div class="card-body">

                        <div class="small text-muted">

                            @if (message.Sender == InsurerMessageSender.Insurer)
                            {
                                var senderName = message.SentByUser != null
                                    ? $"{message.SentByUser.FirstName} {message.SentByUser.LastName}".Trim()
                                    : "";

                                <strong>
                                    @(string.IsNullOrWhiteSpace(senderName)
                                        ? Model.Contract.Insurer?.Name ?? "Insurer"
                                        : senderName)
                                </strong>
                            }
                            else
                            {
                                <strong>
                                    @(message.SentByUser != null
                                        ? $"{message.SentByUser.FirstName} {message.SentByUser.LastName}".Trim()
                                        : "Head Office")
                                </strong>
                            }

                            -
                            @message.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")

                        </div>

                        <div class="mt-2">
                            @message.Message
                        </div>

                    </div>

                </div>
            }
</div>
        }

        @if (Model.Contract.InsurerId.HasValue)
        {
            <form asp-action="ReplyToInsurer"
                  method="post"
                  class="mt-3">

                <input type="hidden"
                       name="contractId"
                       value="@Model.Contract.Id" />

                <div class="form-group">

                    <label asp-for="InsurerMessage"
                           class="control-label">
                        Message
                    </label>

                    <textarea asp-for="InsurerMessage"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="InsurerMessage"
                          class="text-danger"></span>

                </div>

                <div class="mt-2">

                    <button type="submit"
                            class="btn btn-primary btn-sm">
                        Send Message
                    </button>

                </div>

            </form>
        }
        else
        {
            <div class="alert alert-light border">
                This contract does not have an insurance company assigned.
            </div>
        }

    </div>

</div>

