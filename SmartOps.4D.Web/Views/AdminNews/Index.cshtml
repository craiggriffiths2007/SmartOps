@model IReadOnlyList<SmartOps.Web.Models.NewsArticle>

@{
    ViewData["Title"] = "News Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">News</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>&nbsp;New article
    </a>
</div>

@if (TempData["NewsMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm">
    <div class="record-list-section">
        <div class="record-cards">
@if (Model.Count == 0)
                {
                    <p class="text-muted py-3">No news articles yet.</p>
                }
                else
                {
                    @foreach (var article in Model)
                    {
                        <article class="record-card">
    <div class="record-card-title fw-bold"><a href="@Url.Action("Edit", new { id = article.Id })" class="stretched-link"><div class="fw-semibold">@article.Title</div>
                                <div class="small text-muted">@article.Summary</div></a></div>
    <div class="record-card-fields">

                            <div class="record-card-field">
                <span class="record-field-label">Publish date</span>
                @article.PublishedDate.ToString("dd/MM/yyyy HH:mm")
            </div>
                            <div class="record-card-field">
                <span class="record-field-label">Status</span>
@if (article.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                }
            </div>
                            <div class="record-card-field"><span class="record-field-label">Actions</span>
@if (article.IsPublished && article.PublishedDate <= DateTime.UtcNow)
                                {
                                    <a asp-controller="News"
                                       asp-action="Details"
                                       asp-route-id="@article.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       target="_blank">
                                        View
                                    </a>
                                }

                                <a asp-action="Edit"
                                   asp-route-id="@article.Id"
                                   class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@article.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
</div>

    </div>
</article>
                    }
                }
</div>
<record-pagination></record-pagination>
    </div>
</div>
