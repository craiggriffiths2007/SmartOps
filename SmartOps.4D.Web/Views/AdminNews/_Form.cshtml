@model SmartOps.Web.Models.NewsArticle

<link href="~/lib/quill.snow.css" rel="stylesheet" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Title" class="form-label fw-bold"></label>
    <input asp-for="Title" class="form-control" maxlength="200" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Summary" class="form-label fw-bold"></label>
    <textarea asp-for="Summary"
              class="form-control"
              rows="3"
              maxlength="500"></textarea>
    <div class="form-text">Shown on the public News list and used as the page description.</div>
    <span asp-validation-for="Summary" class="text-danger"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="PublishedDate" class="form-label fw-bold"></label>
        <input asp-for="PublishedDate"
               type="datetime-local"
               class="form-control"
               value="@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="PublishedDate" class="text-danger"></span>
    </div>

    <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label fw-bold"></label>
        </div>
    </div>
</div>

<div class="mb-4">
    <label class="form-label fw-bold">Article body</label>

    <div id="newsEditor" class="news-editor"></div>

    <input asp-for="BodyHtml" type="hidden" id="BodyHtml" />
    <span asp-validation-for="BodyHtml" class="text-danger"></span>
</div>
