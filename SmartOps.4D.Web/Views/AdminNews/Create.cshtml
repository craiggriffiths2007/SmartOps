@model SmartOps.Web.Models.NewsArticle

@{
    ViewData["Title"] = "New News Article";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">New News Article</h2>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</div>

<form asp-action="Create" method="post" id="newsForm">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />

    

<div class="text-end">
        <button type="submit" class="btn btn-primary ms-auto">Save article</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/quill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const quill = new Quill('#newsEditor', {
                theme: 'snow',
                placeholder: 'Write the news article here...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike', { color: [] }],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['clean']
                    ]
                }
            });

            const body = document.getElementById('BodyHtml').value;
            if (body) {
                quill.clipboard.dangerouslyPasteHTML(body);
            }

            document.getElementById('newsForm').addEventListener('submit', function () {
                document.getElementById('BodyHtml').value = quill.root.innerHTML;
            });
        });
    </script>
}
