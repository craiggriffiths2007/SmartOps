@model SmartOps.Web.Models.Agent

@{
    ViewData["Title"] = "Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Agent</h4>

    <a asp-action="Index"
       class="btn btn-secondary">
        Close
    </a>
</div>
<hr />

<div class="row">

    <div class="col-md-4">

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Code)
            </div>
            <div>
                @Html.DisplayFor(model => model.Code)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Name)
            </div>
            <div>
                @Html.DisplayFor(model => model.Name)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.SerialNumber)
            </div>
            <div>
                @(string.IsNullOrWhiteSpace(Model.SerialNumber) ? "Not assigned" : Model.SerialNumber)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.Type)
            </div>
            <div>
                @Model.Type.ToString()
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                Branch
            </div>
            <div>
                @(Model.Branch?.Name ?? "Not assigned")
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.CurrentAppVersion)
            </div>
            <div>
                @(string.IsNullOrWhiteSpace(Model.CurrentAppVersion) ? "Not reported yet" : Model.CurrentAppVersion)
            </div>
        </div>

        <div class="mb-3">
            <div class="fw-bold">
                @Html.DisplayNameFor(model => model.LoggedInDateTime)
            </div>
            <div>
                @if (Model.LoggedInDateTime.Year != 1)
                {
                    @Model.LoggedInDateTime.ToString("dd/MM/yyyy HH:mm")
                }
            </div>
        </div>

    </div>

</div>



<div class="mt-4 d-flex justify-content-between align-items-center">

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Delete Agent
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary ms-auto">
        Edit
    </a>


</div>
