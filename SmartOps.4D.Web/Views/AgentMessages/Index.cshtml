@model IEnumerable<SmartOps.Web.Models.AgentMessage>
@{
    ViewData["Title"] = "Agent Mail";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Agent Mail</h4>
    <a asp-action="Create" class="btn btn-primary">New Mail</a>
</div>

<div class="table-responsive record-index-list">
    <table class="table table-sm table-hover align-middle record-index-table mb-0">
        <caption class="visually-hidden">Agent Mail</caption>
        <thead>
            <tr>
                <th scope="col">Subject</th>
                <th scope="col">Sent</th>
                <th scope="col">Created by</th>
                <th scope="col">Recipients</th>
                <th scope="col">Read</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-muted py-3">No records found.</td></tr>
            }
            @foreach (var item in Model)
            {
                var detailsUrl = Url.Action("Details", new { id = item.Id });
                <tr class="clickable-row" data-href="@detailsUrl" tabindex="0">
                    <th scope="row" class="record-index-text">@item.Subject</th>
                    <td>@item.Created.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                    <td>@item.CreatedBy</td>
                    <td>@item.Recipients.Count</td>
                    <td>@item.Recipients.Count(x => x.IsRead) / @item.Recipients.Count</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<record-pagination></record-pagination>
