@model SmartOps.Web.Models.AgentMessage
@{
    ViewData["Title"] = "Delete Mail";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Delete Mail</h4>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
</div>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this mail?</strong><br />
    This will also remove it from all selected agents and cannot be undone.
</div>

<dl class="row">
    <dt class="col-sm-2">Sent</dt>
    <dd class="col-sm-10">@Model.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-2">Subject</dt>
    <dd class="col-sm-10">@Model.Subject</dd>

    <dt class="col-sm-2">Created by</dt>
    <dd class="col-sm-10">@Model.CreatedBy</dd>

    <dt class="col-sm-2">Recipients</dt>
    <dd class="col-sm-10">@Model.Recipients.Count</dd>
</dl>

<div class="card mb-4">
    <div class="card-body quill-message">@Html.Raw(Model.BodyHtml)</div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    

<div class="text-end">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete Mail</button>
    </div>
</form>
