@model IReadOnlyList<SmartOps.Web.Models.NewsArticle>

@{
    ViewData["Title"] = "News";
    ViewData["Description"] = "News, product updates and development updates from SmartOps field service management software.";
}

<div class="news-page">

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">
            No news articles have been published yet.
        </div>
    }
    else
    {
        <div class="record-cards">
            @foreach (var article in Model)
            {
                <div class="record-list-section">
                    <a asp-controller="News"
                       asp-action="Details"
                       asp-route-id="@article.Id"
                       class="news-card-link">

                        <article class="record-card news-card">
                            <div class="card-body d-flex flex-column">

                                <div class="small text-muted mb-2">
                                    @article.PublishedDate.ToString("d MMMM yyyy")
                                </div>

                                <h2 class="h4 mb-3">
                                    @article.Title
                                </h2>

                                <p class="text-muted flex-grow-1 mb-0">
                                    @article.Summary
                                </p>

                            </div>
                        </article>

                    </a>
                </div>
            }
        </div>
    }
</div>

<record-pagination></record-pagination>

<style>
    .news-card-link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .news-card-link:hover {
        color: inherit;
        text-decoration: none;
    }

    .news-card {
        cursor: pointer;
        transition: transform 0.15s ease,
                    box-shadow 0.15s ease;
    }

    .news-card-link:hover .news-card {
        transform: translateY(-2px);
        box-shadow: 0 5px 16px rgba(0, 0, 0, 0.12);
    }

    .news-card-link:focus-visible {
        outline: 2px solid #0d6efd;
        outline-offset: 3px;
        border-radius: 6px;
    }
</style>
