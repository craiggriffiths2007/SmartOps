@model SmartOps.Web.ViewModels.InvoiceCreateViewModel
@{
    ViewData["Title"] = "Create invoice";
}
<link rel="stylesheet" href="~/css/pages/invoices.css" asp-append-version="true" />
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h4>Create invoice · @Model.ContractCode</h4>
    <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId" asp-route-tab="estimation" class="btn btn-secondary">Back to contract</a>
</div>
<form asp-action="Create" method="post" id="invoice-form">
    <input asp-for="ContractId" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label for="InvoiceBillToName" class="form-label">Bill to · @Model.BillingPartyText</label>
            <input id="InvoiceBillToName" class="form-control mb-2" value="@Model.BillToName" readonly />
            <textarea id="InvoiceBillToAddress" class="form-control" rows="3" readonly>@Model.BillToAddress</textarea>
            <div class="form-text">The contract's insurer selection determines the invoice recipient.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="InvoiceDate" class="form-label"></label>
            <input asp-for="InvoiceDate" class="form-control mb-2" required />
            <label asp-for="VatRegistrationNumber" class="form-label"></label>
            <input asp-for="VatRegistrationNumber" class="form-control" maxlength="50" />
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.EstimateReference))
    {
        <p class="text-muted">Prefilled from @Model.EstimateReference. Review the lines before issuing.</p>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-8">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" maxlength="200" required placeholder="Work completed" />
        </div>
        <div class="col-md-4">
            <label asp-for="VatRate" class="form-label"></label>
            <input asp-for="VatRate" type="number" min="0" max="100" step="0.01" required class="form-control" />
        </div>
    </div>
    <p class="text-muted">Enter each line cost excluding VAT. VAT is calculated on the subtotal.</p>
    <div class="table-responsive">
        <table class="table align-middle invoice-lines-table">
            <thead><tr><th scope="col">Details</th><th scope="col" style="width:12rem">Cost excluding VAT (£)</th><th scope="col" style="width:6rem">Actions</th></tr></thead>
            <tbody id="invoice-lines">
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <tr>
                        <td><label asp-for="Lines[i].Details" class="visually-hidden">Line details</label><textarea asp-for="Lines[i].Details" class="form-control" rows="2" maxlength="2000" required></textarea></td>
                        <td><label asp-for="Lines[i].Cost" class="visually-hidden">Line cost excluding VAT</label><input asp-for="Lines[i].Cost" class="form-control invoice-cost" type="number" min="0" max="999999999.99" step="0.01" required /></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-line aria-label="Remove invoice line">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button type="button" id="add-invoice-line" class="btn btn-outline-secondary mb-3">Add line</button>
    <dl class="row text-end" aria-live="polite" aria-atomic="true">
        <dt class="col-8">Subtotal</dt><dd class="col-4" id="invoice-subtotal">£0.00</dd>
        <dt class="col-8">VAT <span id="invoice-vat-rate"></span></dt><dd class="col-4" id="invoice-vat">£0.00</dd>
        <dt class="col-8">Total including VAT</dt><dd class="col-4 fw-bold" id="invoice-total">£0.00</dd>
    </dl>
    <button type="submit" class="btn btn-primary">Issue invoice</button>
</form>
<template id="invoice-line-template">
    <tr>
        <td><label class="visually-hidden">Line details</label><textarea class="form-control" rows="2" maxlength="2000" required></textarea></td>
        <td><label class="visually-hidden">Line cost excluding VAT</label><input class="form-control invoice-cost" type="number" min="0" max="999999999.99" step="0.01" value="0.00" required /></td>
        <td><button type="button" class="btn btn-outline-danger btn-sm" data-remove-line aria-label="Remove invoice line">Remove</button></td>
    </tr>
</template>
@section Scripts {
    <script src="~/js/invoices.js" asp-append-version="true"></script>
}
