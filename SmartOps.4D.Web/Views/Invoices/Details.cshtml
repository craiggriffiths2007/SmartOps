@model SmartOps.Web.Models.Invoice
@{ ViewData["Title"] = Model.InvoiceNumber; }
<link rel="stylesheet" href="~/css/pages/invoices.css" asp-append-version="true" />
<div class="invoice-actions d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><a asp-action="Index" class="btn btn-secondary">Back to invoices</a> <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-secondary">View contract</a></div>
    <a asp-action="Print" asp-route-id="@Model.Id" data-print-document class="btn btn-primary">Print invoice</a>
</div>
<partial name="_InvoiceBody" model="Model" />
