
@model SmartOps.Web.ViewModels.InsurerEditViewModel

@{
    ViewData["Title"] = "Create Insurer";
    ViewData["IsEdit"] = false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Create Insurer</h4>

    <a asp-action="Index"

       class="btn btn-secondary">
        Cancel
    </a>
</div>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <partial name="_InsurerForm"
                     model="Model"
                     view-data="ViewData" />
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
