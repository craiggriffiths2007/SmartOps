@model SmartOps.Web.Models.Vehicle

<div class="form-group">
    <label asp-for="BranchId" class="control-label">
        Branch
    </label>

    <select lock-branch-value="@((object?)Model?.BranchId ?? (ViewBag.BranchId as SelectList)?.SelectedValue)" asp-for="BranchId"
            class="form-select"
            asp-items="ViewBag.BranchId">
        <option value="">-- Select Branch --</option>
    </select>

    <span asp-validation-for="BranchId"
          class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Name" class="control-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Registration" class="control-label"></label>
    <input asp-for="Registration" class="form-control" />
    <span asp-validation-for="Registration" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Description" class="control-label"></label>
    <input asp-for="Description" class="form-control" />
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Type" class="control-label"></label>

    <select asp-for="Type"
            class="form-select"
            asp-items="Html.GetEnumSelectList<enum_vehicle_type>()">
    </select>

    <span asp-validation-for="Type"
          class="text-danger"></span>
</div>