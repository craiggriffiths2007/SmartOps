@model IEnumerable<SmartOps.Web.Models.VAccident>
@using SmartOps.Shared.Models
@{
    ViewData["Title"] = "Vehicle Accidents";
}
<h4 class="mb-3">Vehicle Accidents</h4>
<div class="table-responsive record-index-list">
    <table class="table table-sm table-hover align-middle record-index-table mb-0">
        <caption class="visually-hidden">Vehicle Accidents</caption>
        <thead>
            <tr>
                <th scope="col">Completed</th>
                <th scope="col">Accident date</th>
                <th scope="col">Accident time</th>
                <th scope="col">Third-party registration</th>
                <th scope="col">Third-party model</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-muted py-3">No records found.</td></tr>
            }
            @foreach (var item in Model)
            {
                var answers = VehicleAccidentQuestions.Answers(item.AccidentAnswersJson);
                var detailsUrl = Url.Action("Details", new { id = item.Id });
                <tr class="clickable-row" data-href="@detailsUrl" tabindex="0">
                    <th scope="row">@item.DateTimeCompleted.ToString("dd/MM/yyyy HH:mm")</th>
                    <td>@VehicleAccidentQuestions.Value(answers, "acc_date")</td>
                    <td>@VehicleAccidentQuestions.Value(answers, "acc_time")</td>
                    <td>@VehicleAccidentQuestions.Value(answers, "t_reg")</td>
                    <td>@VehicleAccidentQuestions.Value(answers, "t_model")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<record-pagination></record-pagination>