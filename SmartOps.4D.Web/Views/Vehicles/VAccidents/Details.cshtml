@model SmartOps.Web.Models.VAccident
@using SmartOps.Shared.Models
@{
    ViewData["Title"] = "Vehicle accident";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 no-print">
    <h4 class="mb-0">Vehicle accident</h4>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Print vehicle accident</button>
        <button type="button" class="btn btn-secondary" onclick="history.back()">Back</button>
    </div>
</div>
@if (Model == null)
{
    <p class="text-muted">No data available.</p>
}
else
{
    var entries = string.IsNullOrWhiteSpace(Model.AccidentQuestionsSnapshotJson)
        ? Array.Empty<JobQuestionnaireLogic.ReportEntry>()
        : JobQuestionnaireLogic.ReportEntries(VehicleAccidentQuestions.Definition(Model.AccidentQuestionsSnapshotJson), VehicleAccidentQuestions.Answers(Model.AccidentAnswersJson)).ToArray();
    var mediaSections = new[]
    {
        (Title: "Signature", Images: new (string Caption, string? Filename)[]
        {
            ("Driver signature", ViewData["Sign"] as string)
        }),
        (Title: "Accident drawing", Images: new (string Caption, string? Filename)[]
        {
            ("Accident drawing", ViewData["Drawing"] as string)
        }),
        (Title: "Photographs", Images: ((IEnumerable<PhotoImage>?)ViewBag.Images ?? Enumerable.Empty<PhotoImage>())
            .Where(image => !string.IsNullOrWhiteSpace(image.Filename))
            .Select((image, index) => (Caption: $"Photograph {index + 1}", Filename: (string?)image.Filename)).ToArray())
    };
    <article class="go-item-report">
        <section class="go-report-section">
            <h3>Accident details</h3>
            @if (entries.Length == 0)
            {
                <p>No dynamic accident questionnaire recorded.</p>
            }
            @foreach (var entry in entries)
            {
                if (entry.IsInformation)
                {
                    <h4>@entry.Label</h4>
                }
                else if (entry.Image == null)
                {
                    <dl class="go-report-fields">
                        <div class="go-report-field"><dt>@entry.Label</dt><dd><span class="go-report-field-value">@entry.Value</span></dd></div>
                    </dl>
                }
            }
        </section>
    @foreach (var mediaSection in mediaSections)
    {
        if (!mediaSection.Images.Any(image => !string.IsNullOrWhiteSpace(image.Filename))) continue;
        <section class="go-report-media-section">
            <h3 class="go-report-media-title">@mediaSection.Title</h3>
            <partial name="_RecordReportMedia" model="mediaSection.Images" />
        </section>
    }
    </article>
}