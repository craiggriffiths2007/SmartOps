@model SmartOps.Web.Models.FAccident
@using SmartOps.Shared.Models
@{
    ViewData["Title"] = "Delete work accident";
    var answers = WorkAccidentQuestions.Answers(Model.AccidentAnswersJson);
}
<h4>Delete work accident</h4>
<p>Are you sure you want to delete this report?</p>
<dl class="row">
    <dt class="col-sm-2">Report type</dt><dd class="col-sm-10">@Model.Type</dd>
    <dt class="col-sm-2">Recorded</dt><dd class="col-sm-10">@Model.date_time.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@WorkAccidentQuestions.Value(answers, WorkAccidentQuestions.IsNearMiss(Model.Type) ? "anon_or_name" : "full_name")</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
