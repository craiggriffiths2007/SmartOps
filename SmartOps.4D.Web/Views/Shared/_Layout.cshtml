@using Microsoft.AspNetCore.Identity
@using SmartOps.Web.Data

@using Microsoft.EntityFrameworkCore

@inject UserManager<AppUser> UserManager
@inject AppDBContext DbContext

@inject ITenantContext TenantContext

@{
    var firstName = User.FindFirst("FirstName")?.Value;
    var isFourDErrorLog = ViewContext.RouteData.Values["controller"]?.ToString() == "FourDErrorLog";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var pictureVersion = User.FindFirst("ProfilePictureVersion")?.Value;

    var pageTitle = ViewData["Title"]?.ToString() ?? "Mart Ops";

    var pageDescription =
        ViewData["Description"]?.ToString()
        ?? "Mart Ops connects back-office teams with surveyors, fitters and field staff through integrated scheduling, mobile surveying, fitting and operational management software.";

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var canDiary = User.IsInRole("Admin") || User.IsInRole("Diary");
    var canBranch = User.IsInRole("Admin") || User.IsInRole("Branch");
    var canUsers = User.IsInRole("Admin") || User.IsInRole("Users") || User.IsInRole("SuperAdmin");

    var isInsurer =
        User.IsInRole("Insurer");

    string insurerName = "";

    var siteThemeColour = SiteThemes.All["Midnight"];

    if (isAuthenticated &&
        !isInsurer &&
        !User.IsInRole("SuperAdmin") &&
        TenantContext.TenantId.HasValue && !isFourDErrorLog)
    {
        var tenantTheme = await DbContext.Tenant
            .Where(t => t.Id == TenantContext.TenantId.Value)
            .Select(t => t.Theme)
            .FirstOrDefaultAsync();

        siteThemeColour = SiteThemes.GetColour(tenantTheme);
    }

    if (isInsurer && userId != null)
    {
        var insurerUser = await UserManager.Users
            .Include(u => u.Insurer)
            .FirstOrDefaultAsync(u => u.Id == userId);

        insurerName =
            insurerUser?.Insurer?.Name ?? "Insurance Portal";
    }
}

