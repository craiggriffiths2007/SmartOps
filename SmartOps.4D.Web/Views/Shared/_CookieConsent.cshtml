
<div id="cookie-banner" class="cookie-banner" hidden
     role="region" aria-label="Cookie preferences">
    <div class="cookie-content">
        <div>
            <h5>We use cookies</h5>
            <p>
                Mart Ops uses essential cookies to keep
                the website secure and working correctly.
                With your permission, we may also use
                optional analytics cookies.
            </p>
        </div>
        <div class="cookie-actions">
            <button type="button" data-cookie-choice="all">
                Accept all
            </button>
            <button type="button" data-cookie-choice="essential">
                Reject optional
            </button>
        </div>
    </div>
</div>
