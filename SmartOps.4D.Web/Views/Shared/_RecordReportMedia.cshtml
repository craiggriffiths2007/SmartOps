@model IEnumerable<(string Caption, string? Filename)>
@{
    var images = Model.Where(image => !string.IsNullOrWhiteSpace(image.Filename)).ToList();
}
@if (images.Count > 0)
{
    <div class="container-fluid px-0">
        <div class="row g-3 go-report-media-grid">
            @foreach (var image in images)
            {
                <div class="col-6 col-md-3 go-report-media-card">
                    <figure class="m-0">
                        <a href="@Url.Content($"~/images/{image.Filename}")" class="image-lightbox-link">
                            <img src="@Url.Content($"~/images/{image.Filename}")" class="media-thumbnail"
                                 alt="@image.Caption" loading="eager" />
                        </a>
                        <figcaption class="go-report-meta text-center mt-1">@image.Caption</figcaption>
                    </figure>
                </div>
            }
        </div>
    </div>
}