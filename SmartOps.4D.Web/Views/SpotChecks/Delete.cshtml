@model SmartOps.Web.Models.SpotCheck
@{ ViewData["Title"] = "Delete spot check"; }
<h4>Delete spot check</h4>
<p>Are you sure you want to delete this spot check?</p>
<dl class="row">
    <dt class="col-sm-2">Contract</dt><dd class="col-sm-10">@Model.ContractCode</dd>
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Postcode</dt><dd class="col-sm-10">@Model.Postcode</dd>
    <dt class="col-sm-2">Check date</dt><dd class="col-sm-10">@Model.date_done</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
