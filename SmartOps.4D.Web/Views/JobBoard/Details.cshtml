@model InsuranceClaim

@{
    ViewData["Title"] = "Job Board Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Job Details</h3>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Close
    </a>
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Postcode
    </dt>
    <dd class="col-sm-9">
        @Model.Postcode
    </dd>

    <dt class="col-sm-3">
        Incident Date
    </dt>
    <dd class="col-sm-9">
        @Model.IncidentDate.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">
        Cause of Damage
    </dt>
    <dd class="col-sm-9">
        @Model.CauseOfDamage
    </dd>

    <dt class="col-sm-3">
        Damage Description
    </dt>
    <dd class="col-sm-9">
        @Model.DamageDescription
    </dd>

</dl>
@if (Model.Photos.Any())
{
    <hr />

    <h4>Claim Photographs</h4>

    <div class="row g-3 mb-4">
        @foreach (var photo in Model.Photos)
        {
            <div class="col-6 col-md-3">
                <a asp-action="ClaimPhoto"
                   asp-route-id="@photo.Id"
                   target="_blank">

                    <img src="@Url.Action(
                                                      "ClaimPhoto",
                                                      new { id = photo.Id })"
                         class="img-fluid rounded border record-photo"
                         alt="Claim photograph" />
                </a>
            </div>
        }
    </div>
}
<hr />

@if (User.IsInRole("Admin"))
{
    if ((bool)ViewBag.Requested)
    {
        <div class="alert alert-success">
            Your company requested this job on
            @(((DateTime)ViewBag.RequestedDate)
                .ToLocalTime()
                .ToString("dd/MM/yyyy HH:mm")).
        </div>
    }
    else
    {
        <form asp-action="RequestJob"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary">
                Request Job
            </button>

        </form>
    }
}