@model IEnumerable<JobBoardItemViewModel>

@{
    ViewData["Title"] = "Job Board";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Job Board</h3>

    <a asp-controller="JobBoard"
       asp-action="MyRequests"
       class="btn btn-secondary">
        My Jobs
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        There are currently no jobs available.
    </div>
}
else
{
    @if (!Model.Any())
{
    <p class="text-muted py-3">No records found.</p>
}
<div class="record-cards">
@foreach (var job in Model)
            {
                <article class="record-card">
    <div class="record-card-title fw-bold"><a href="@Url.Action("Details", new { id = job.Id })" class="stretched-link">@job.Postcode</a></div>
    <div class="record-card-fields">

                    <div class="record-card-field">
                <span class="record-field-label">Incident Date</span>
                @job.IncidentDate.ToString("dd/MM/yy")
            </div>

                    <div class="record-card-field">
                <span class="record-field-label">Cause</span>
                @job.CauseOfDamage
            </div>

                    <div class="record-card-field">
                <span class="record-field-label">Description</span>
                @job.DamageDescription
            </div>
                    <div class="record-card-field">
                <span class="record-field-label">Status</span>
@if (job.Requested)
                        {
                            <span class="badge bg-success">
                                Requested
                            </span>
                }
            </div>

    </div>
</article>
            }
</div>
<record-pagination></record-pagination>
}
