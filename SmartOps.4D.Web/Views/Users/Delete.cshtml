@model SmartOps.Web.Models.UserRolesViewModel

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<h3>Are you sure you want to delete this user?</h3>
<div>
    <h4>User</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.UserName</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">@(Model.Roles != null ? string.Join(", ", Model.Roles) : "None")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" value="@Model.UserId" name="id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div>