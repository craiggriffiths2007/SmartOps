@model SmartOps.Web.Data.AppUser

@if (User.IsInRole("SuperAdmin") && !Model.EmailConfirmed)
{
    <div class="mt-3 mb-3">
        <p class="text-muted mb-2">This user's email address has not been confirmed.</p>
        <form asp-action="ResendConfirmation" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-primary">Resend confirmation link</button>
        </form>
    </div>
}
