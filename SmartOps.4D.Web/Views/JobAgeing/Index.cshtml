@model SmartOps.Web.ViewModels.JobAgeingViewModel
@{
    ViewData["Title"] = "Job Ageing";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Job Ageing</h4>
</div>
<div class="table-responsive record-index-list">
    <table class="table table-sm table-hover align-middle record-index-table mb-0">
        <thead>
            <tr>
                <th scope="col">Contract</th>
                <th scope="col">Customer</th>
                <th scope="col">Status</th>
                <th scope="col">Action required</th>
                <th scope="col">Last Action</th>
                <th scope="col" class="text-center">Traffic Light</th>
                <th scope="col">Contract created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@row.ContractId">@row.ContractNumber</a></td>
                    <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@row.CustomerId">@(string.IsNullOrWhiteSpace(row.CustomerName) ? "Unknown customer" : row.CustomerName)</a></td>
                    <td>@row.Status</td>
                    <td>
                        @if (row.ActionParameter == "contractId")
                        {
                            <a asp-controller="@row.ActionController" asp-action="@row.ActionName" asp-route-contractId="@row.ContractId">@row.ActionRequired</a>
                        }
                        else
                        {
                            <a asp-controller="@row.ActionController" asp-action="@row.ActionName" asp-route-id="@row.ContractId" asp-route-tab="@row.ActionTab">@row.ActionRequired</a>
                        }
                    </td>
                    <td title="@(row.Health.StatusSince.HasValue ? $"Status updated: {row.Health.StatusSince.Value:dd/MM/yyyy HH:mm}" : "No dated status update")">@row.Age</td>
                    <td class="text-center"><span role="img" aria-label="@row.Health.Reason" title="@row.Health.Reason" style="display:inline-block;width:.85rem;height:.85rem;border-radius:50%;background-color:@row.Health.DisplayColor"></span></td>
                    <td>@(row.Health.CreatedAt?.ToString("dd/MM/yyyy") ?? "Unknown")</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No outstanding contracts.</td></tr>
            }
        </tbody>
    </table>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Job ageing pages">
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p">@p</a></li>
            }
        </ul>
    </nav>
}
<p class="small text-muted mt-3">Working days since the current status update. Unknown means no reliable status-change timestamp exists in 4D.</p>
