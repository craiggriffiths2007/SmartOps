@{
    ViewData["Title"] = "Insurer Portal";
}

<h1>@ViewBag.InsurerName</h1>

<p class="text-muted">
    Mart Ops Insurance Portal
</p>

<hr />

<div class="row">

    <div class="col-md-4">

        <div class="card">
            <div class="card-body">

                <h5 class="card-title">
                    Contracts
                </h5>

                <h2>
                    @ViewBag.ContractCount
                </h2>

                <p class="text-muted">
                    Contracts currently associated with your company.
                </p>

            </div>
        </div>

    </div>

</div>