@model InsuranceClaim

@{
    ViewData["Title"] = "Claim Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Claim Details</h1>
        <div class="text-muted">
            Reference: @Model.ClaimReference
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Claims
    </a>
</div>

<hr />

<div class="row">
    <div class="col-md-6">

        <h4>Claim</h4>

        <dl class="row">
            <dt class="col-sm-4">Claim Reference</dt>
            <dd class="col-sm-8">@Model.ClaimReference</dd>

            <dt class="col-sm-4">Policy Number</dt>
            <dd class="col-sm-8">@Model.PolicyNumber</dd>

            <dt class="col-sm-4">Incident Date</dt>
            <dd class="col-sm-8">
                @Model.IncidentDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-4">Cause of Damage</dt>
            <dd class="col-sm-8">@Model.CauseOfDamage</dd>

            <dt class="col-sm-4">Damage Description</dt>
            <dd class="col-sm-8">@Model.DamageDescription</dd>

            <dt class="col-sm-4">Excess</dt>
            <dd class="col-sm-8">@Model.Excess</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <strong>@Model.Status</strong>
            </dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">
                @Model.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </dd>
        </dl>

    </div>

    <div class="col-md-6">

        <h4>Policyholder</h4>

        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.CustomerName</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">
                @Model.Address1

                @if (!string.IsNullOrWhiteSpace(Model.Address2))
                {
                    <br />
                    @Model.Address2
                }

                @if (!string.IsNullOrWhiteSpace(Model.Address3))
                {
                    <br />
                    @Model.Address3
                }

                @if (!string.IsNullOrWhiteSpace(Model.Postcode))
                {
                    <br />
                    @Model.Postcode
                }
            </dd>

            <dt class="col-sm-4">Telephone</dt>
            <dd class="col-sm-8">@Model.Telephone</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>
        </dl>

    </div>
</div>

@if (Model.Photos.Any())
{
    <hr />

    <h4>Damage Photographs</h4>

    <div class="row g-3 mb-4">
        @foreach (var photo in Model.Photos)
        {
            <div class="col-6 col-md-3">
                <a asp-action="Photo"
                   asp-route-id="@photo.Id"
                   target="_blank">

                    <img src="@Url.Action("Photo", "Claims",
                                  new
                                  {
                                      area = "Insurer",
                                      id = photo.Id
                                  })"
                         class="img-fluid rounded border record-photo"
                         alt="Claim photograph" />
                </a>
            </div>
        }
    </div>
}

<hr />

<h4>Assignment</h4>

@if (Model.AssignedTenantId.HasValue)
{
    <dl class="row">

        <dt class="col-sm-2">
            Assigned To
        </dt>

        <dd class="col-sm-10">
            @ViewBag.AssignedTenantName
        </dd>

        <dt class="col-sm-2">
            Contract
        </dt>

        <dd class="col-sm-10">
            @if (ViewBag.ContractId != null)
            {
                <a asp-area="Insurer"
                   asp-controller="Contracts"
                   asp-action="Details"
                   asp-route-id="@ViewBag.ContractId">
                    @ViewBag.ContractCode
                </a>
            }
            else
            {
                <span class="text-muted">Not created</span>
            }
        </dd>

        <dt class="col-sm-2">
            Assigned
        </dt>

        <dd class="col-sm-10">
            @(Model.AssignedDate?.ToLocalTime()
                .ToString("dd/MM/yyyy HH:mm") ?? "")
        </dd>

    </dl>
}
else if (Model.Status == InsuranceClaimStatus.OnJobBoard)
{
    <div class="alert alert-info">
        This claim is currently published to the Mart Ops Job Board.
    </div>

    <h5 class="mt-4">Job Board Requests</h5>

    var requests =
        ViewBag.JobBoardRequests
            as List<InsuranceClaimRequest>;

    var tenantNames =
        ViewBag.JobBoardTenantNames
            as Dictionary<int, string>;

    @if (requests == null || !requests.Any())
    {
        <p class="text-muted">
            No glazing companies have requested this job yet.
        </p>
    }
    else
    {
        <div class="record-cards" data-paginate>
@foreach (var request in requests)
                {
                    <article class="record-card">
    <div class="record-card-title fw-bold"><span>@(tenantNames != null &&
                              tenantNames.TryGetValue(
                                  request.TenantId,
                                  out var tenantName)
                                ? tenantName
                                : "Unknown")</span></div>
    <div class="record-card-fields">

                        <div class="record-card-field">
                <span class="record-field-label">Requested</span>
                @request.RequestedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>

                        <div class="record-card-field">
                <span class="record-field-label">Status</span>
                @request.Status
            </div>

                        <div class="record-card-field">
                <span class="record-field-label">Actions</span>
@if (request.Status ==
                                InsuranceClaimRequestStatus.Pending)
                            {
                                <form asp-action="SelectJobBoardCompany"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="claimId"
                                           value="@Model.Id" />

                                    <input type="hidden"
                                           name="requestId"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        Select Company
                                    </button>
                                </form>
                            }
</div>

    </div>
</article>
                }
</div>
    }
}
else
{
    <div class="alert alert-warning">
        This claim has not yet been assigned.
    </div>

    @if (!Model.AssignedTenantId.HasValue &&
    Model.Status != InsuranceClaimStatus.OnJobBoard)
    {
        <form asp-action="Assign"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row align-items-end">
                <div class="col-md-5">

                    <label for="tenantId"
                           class="form-label">
                        Glazing Company
                    </label>

                    <select name="tenantId"
                            id="tenantId"
                            asp-items="ViewBag.GlazingCompanies"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Glazing Company --
                        </option>

                    </select>

                </div>

                <div class="col-md-auto">

                    <button type="submit"
                            class="btn btn-primary">
                        Assign to Glazing Company
                    </button>

                </div>
            </div>

        </form>
    }

    <form asp-action="PublishToJobBoard"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-outline-primary">
            Publish to Job Board
        </button>
    </form>
}

                            <hr />

<h4>Claim History</h4>

@{
    var claimUpdates =
        ViewBag.ClaimUpdates as List<InsuranceClaimUpdate>;
}

@if (claimUpdates == null || !claimUpdates.Any())
{
    <p class="text-muted">
        No claim history is available.
    </p>
}
else
{
    <div class="record-cards" data-paginate>
@foreach (var update in claimUpdates)
            {
                <article class="record-card">
    <div class="record-card-title fw-bold"><span>@update.DateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
    <div class="record-card-fields">

                    <div class="record-card-field"><span class="record-field-label">Event</span>
<strong>@update.Title</strong>
</div>

                    <div class="record-card-field"><span class="record-field-label">Description</span>
                @update.Description
            </div>

                    <div class="record-card-field">
                <span class="record-field-label">Status</span>
                @update.Status
            </div>

    </div>
</article>
            }
</div>
}
