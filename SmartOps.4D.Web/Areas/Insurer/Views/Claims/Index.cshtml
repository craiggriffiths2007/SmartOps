@model IEnumerable<InsuranceClaimListItemViewModel>

@{
    ViewData["Title"] = "Claims";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Claims</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        New Claim
    </a>
</div>

@if (!Model.Any())
{
    <p class="text-muted py-3">No records found.</p>
}
<div class="record-cards">
@foreach (var claim in Model)
        {
            <article class="record-card">
    <div class="record-card-title fw-bold"><a href="@Url.Action("Details", new { id = claim.Id })" class="stretched-link">@claim.ClaimReference</a></div>
    <div class="record-card-fields">

                <div class="record-card-field">
                <span class="record-field-label">Policyholder</span>
                @claim.CustomerName
            </div>
                <div class="record-card-field">
                <span class="record-field-label">Postcode</span>
                @claim.Postcode
            </div>
                <div class="record-card-field">
                <span class="record-field-label">Incident Date</span>
                @claim.IncidentDate.ToString("dd/MM/yy")
            </div>
                <div class="record-card-field">
                <span class="record-field-label">Status</span>
@if (claim.Status == InsuranceClaimStatus.OnJobBoard)
                    {
                        @(claim.BidCount == 1
                            ? "1 Bid"
                            : $"{claim.BidCount} Bids")
                    }
                    else
                    {
                        @claim.Status
                    }
</div>
                <div class="record-card-field"><span class="record-field-label">Assigned To</span>
@if (!string.IsNullOrWhiteSpace(claim.AssignedTenantName))
                    {
                        @claim.AssignedTenantName
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                }
            </div>

                <div class="record-card-field">
                <span class="record-field-label">Contract</span>
@if (claim.ContractId.HasValue)
                    {
                        <a asp-area="Insurer"
                           asp-controller="Contracts"
                           asp-action="Details"
                           asp-route-id="@claim.ContractId.Value">
                            @claim.ContractCode
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                }
            </div>
                <div class="record-card-field">
                <span class="record-field-label">Created</span>
                @claim.Created.ToLocalTime().ToString("dd/MM/yy HH:mm")
            </div>
                <div class="record-card-field"><span class="record-field-label">Actions</span>
<a asp-action="Details"
                       asp-route-id="@claim.Id"
                       class="btn btn-sm btn-outline-primary">
                        View
                    </a>
</div>

    </div>
</article>
        }
</div>
<record-pagination></record-pagination>
