	  <EmbeddedResource Include="DynamicQuestions\Items\PanelQuestions.json" />
      <EmbeddedResource Include="DynamicQuestions\Items\LockmechQuestions.json" />
	  <EmbeddedResource Include="DynamicQuestions\Vehicle\ToolCheckQuestions.json" />
	  <EmbeddedResource Include="DynamicQuestions\Vehicle\DeliveryHGVQuestions.json" />
	  <EmbeddedResource Include="DynamicQuestions\Vehicle\DeliveryVanQuestions.json" />
	  <EmbeddedResource Include="DynamicQuestions\Vehicle\FitterVanQuestions.json" />
	  <EmbeddedResource Include="DynamicQuestions\Vehicle\SalesCarQuestions.json" />
	</ItemGroup>

  <ItemGroup>
    <None Update="DynamicQuestions\Items\CompositeQuestions.json">
      <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </None>
  </ItemGroup>

</Project>
