{
  "questions": [
    {
      "id": "color",
      "question": "Colour",
      "type": "Picker",
      "required": true,
      "options": [
        "White",
        "Black",
        "Green",
        "Red",
        "Blue",
        "Brown",
        "Mahogany"
      ]
    },
    {
      "id": "door_fits_into",
      "question": "Subframe material",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "Timber",
        "Metal"
      ]
    },
    {
      "id": "new_subframe_req",
      "question": "New subframe",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "None",
        "HW",
        "SW",
        "Metal"
      ],
      "optionRules": [
        {
          "conditions": [
            {
              "questionId": "door_fits_into",
              "operator": "Equals",
              "value": "Timber"
            }
          ],
          "options": [
            "Metal"
          ]
        }
      ]
    },
    {
      "id": "obstruction_outside_b",
      "question": "Obstruction outside",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "obstruction_outside",
      "question": "External obstructions and available clearances",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "obstruction_outside_b",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
      "id": "obstruction_inside_b",
      "question": "Obstruction inside",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "obstruction_inside",
      "question": "Internal obstructions and available clearances",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "obstruction_inside_b",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
      "id": "actual_door_width",
      "question": "Actual door width",
      "type": "Measurement",
      "required": true,
      "unit": "mm",
      "minimum": 0.1,
      "wholeNumber": false
    },
    {
      "id": "actual_door_height",
      "question": "Actual door height",
      "type": "Measurement",
      "required": true,
      "unit": "mm",
      "minimum": 0.1,
      "wholeNumber": false
    },
    {
      "id": "frame_fix_type",
      "question": "Frame fix type",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "Back Fix",
        "In-between Fix"
      ]
    },
    {
      "id": "door_within_perimeter",
      "question": "Is the garage door in customers house perimeter",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "where_is_garage",
      "question": "Where is it",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "door_within_perimeter",
        "operator": "Equals",
        "value": "No"
      }
    },
    {
      "id": "type_of_garage",
      "question": "Garage wall / roof construction",
      "type": "Picker",
      "required": true,
      "options": [
        "Brick",
        "Timber",
        "Concrete Prefab",
        "Asbestos",
        "Unknown / suspected asbestos"
      ]
    },
    {
      "id": "new_electric_operator_req",
      "question": "New or replacement electric operator required?",
      "type": "Picker",
      "required": true,
      "options": [
        "Yes",
        "No"
      ],
      "readOnly": true
    },
    {
      "id": "wire_type",
      "question": "Proposed motor supply / isolation arrangement",
      "type": "Picker",
      "required": true,
      "options": [
        "Hard Wired",
        "240v Plug"
      ],
      "showWhen": {
        "questionId": "new_electric_operator_req",
        "operator": "Equals",
        "value": "Yes"
      },
      "readOnly": true
    },
    {
      "id": "socket_within_1m",
      "question": "Suitable earthed 230V socket within manufacturer-permitted cable reach?",
      "type": "YesNo",
      "required": true,
      "showWhen": {
        "questionId": "new_electric_operator_req",
        "operator": "Equals",
        "value": "Yes"
      },
      "showWhenAll": [
        {
          "questionId": "wire_type",
          "operator": "Equals",
          "value": "240v Plug"
        }
      ]
    },
    {
      "id": "electric_door",
      "question": "Will the door be power operated after this work?",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "Yes",
        "No"
      ],
      "optionRules": [
        {
          "conditions": [
            {
              "questionId": "new_electric_operator_req",
              "operator": "Equals",
              "value": "Yes"
            }
          ],
          "options": [
            "Yes"
          ]
        }
      ]
    },
    {
      "id": "motor_position",
      "question": "Motor position (viewed from inside)",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "Left",
        "Right",
        "Centre",
        "Integrated / other - record in safety review"
      ],
      "showWhen": {
        "questionId": "electric_door",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
      "id": "other_access",
      "question": "Independent pedestrian access available when the garage door cannot be opened?",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "need_safety_release",
      "question": "Additional manufacturer-approved external emergency manual release required?",
      "type": "YesNo",
      "required": true,
      "showWhen": {
        "questionId": "electric_door",
        "operator": "Equals",
        "value": "Yes"
      },
      "showWhenAll": [
        {
          "questionId": "other_access",
          "operator": "Equals",
          "value": "No"
        }
      ]
    },
