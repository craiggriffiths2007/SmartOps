{
  "questions": [
    {
      "id": "flex_repair",
      "question": "Repair item",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "flex_reason_not_repaired",
      "question": "Reason item cannot be repaired",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "flex_repair",
        "operator": "Equals",
        "value": "No"
      }
    },
    {
      "id": "flex_replace_glass",
      "question": "Include glass",
      "type": "ReplaceGlass",
      "required": true
    },
    {
      "id": "flex_handles_required",
      "question": "Handles required",
      "type": "Handles",
      "required": true,
      "showWhen": {
        "questionId": "flex_repair",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
      "id": "flex_handles_text",
      "question": "Handle details",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "flex_handles_required",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
