{
  "questions": [
    {
      "id": "flex_repair",
      "question": "Repair item",
      "type": "YesNo",
      "required": true
    },
    {
      "id": "flex_reason_not_repaired",
      "question": "Reason item cannot be repaired",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "flex_repair",
        "operator": "Equals",
        "value": "No"
      }
    },
    {
      "id": "flex_replace_glass",
      "question": "Include roof glass",
      "type": "ReplaceGlass",
      "required": true
    },
    {
      "id": "type",
      "question": "Type of roof",
      "type": "Picker",
      "required": true,
      "options": [
        "Ultralight 500",
        "Flat",
        "Victorian",
        "Edwardian",
        "Other"
      ]
    },
    {
      "id": "spars_line_up",
      "question": "Do the spars line through with the window mullions",
      "type": "YesNo",
      "required": true,
      "showWhen": {
        "questionId": "type",
        "operator": "NotEquals",
        "value": "Ultralight 500"
      }
    },
    {
      "id": "conservatory_drawing_warning",
      "question": "Show all splits, support / fixing details and roof dimensions on the drawing.",
      "type": "Information",
      "required": false,
      "showWhen": {
        "questionId": "spars_line_up",
        "operator": "Equals",
        "value": "Yes"
      }
    },
    {
      "id": "material_type",
      "question": "Material type",
      "type": "ButtonPicker",
      "required": true,
      "options": [
        "Aluminium",
        "Timber",
        "UPVC"
      ]
    },
    {
      "id": "ridge_length",
      "question": "Ridge length",
      "type": "Measurement",
      "required": true,
      "showWhen": {
        "questionId": "type",
        "operator": "NotEquals",
        "value": "Ultralight 500"
      },
      "unit": "mm",
      "minimum": 0,
      "wholeNumber": false
    },
    {
      "id": "wall_pos",
      "question": "Wall position",
      "type": "Picker",
      "required": true,
      "options": [
        "None",
        "Left",
        "Right",
        "Both"
      ],
      "showWhen": {
        "questionId": "type",
        "operator": "In",
        "value": "Ultralight 500|Flat|Edwardian"
      }
    },
    {
      "id": "eaves_connection",
      "question": "Roof / soffit connection and weathering arrangement",
      "type": "Picker",
      "required": true,
      "readOnly": true,
      "options": [
        "Below soffit - flashing / ventilation confirmed",
        "At / above soffit - connection detail required",
        "Unknown - detail / review required"
