{
  "questions": [
    {
      "id": "cause_of_damage",
      "question": "Cause of damage",
      "type": "Picker",
      "required": true,
      "options": [
        "Accidental Damage",
        "Bad Workmanship",
        "Claim inconsistency",
        "Domestic",
        "Fire",
        "Flood",
        "Ground Movement",
        "Impact",
        "Loss of keys",
        "Malicious",
        "Storm Damage",
        "Theft",
        "Wear + Tear"
      ],
      "showWhenAll": [
        {
          "questionId": "$closing_questions",
          "operator": "Equals",
          "value": "True"
        }
      ]
    },
    {
      "id": "cause_of_damage_reason_different",
      "question": "Why is the cause different from the contract?",
      "type": "Text",
      "required": true,
      "showWhen": {
        "questionId": "$damage_different",
        "operator": "Equals",
        "value": "True"
      },
      "showWhenAll": [
        {
          "questionId": "$closing_questions",
